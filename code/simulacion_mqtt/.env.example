# ===== Broker MQTT local =====
MQTT_HOST=0.0.0.0
MQTT_PORT=1883

# Autenticacion opcional (si MQTT_USERNAME esta vacio se permite acceso anonimo)
MQTT_USERNAME=
MQTT_PASSWORD=

# ===== Emulador de la placa =====
MQTT_BROKER_URL=mqtt://localhost:1883
SENSOR_INTERVAL_MS=3000

# Topics (coinciden con Pis_6to.ino)
TEMP_TOPIC=sensor/temperatura
HUM_TOPIC=sensor/humedad
CO2_TOPIC=sensor/co2
CMD_TOPIC=placa/comandos
ACK_TOPIC=placa/ack
